# --- Firebase Admin (server-side only, never exposed to the browser) ---
# From: Firebase console -> Project settings -> Service accounts -> Generate new private key
FIREBASE_PROJECT_ID=your-project-id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-project-id.iam.gserviceaccount.com
# Paste the private key from the downloaded JSON. Keep the \n escapes literal
# (this app converts them to real newlines at startup) - do not reformat.
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nXXXX\n-----END PRIVATE KEY-----\n"

# --- Email notification on new contact submissions ---
# Resend (https://resend.com) - free tier is enough for a personal site.
RESEND_API_KEY=re_xxxxxxxxxxxx
# Must be a verified sender domain in Resend, or their default onboarding sender.
CONTACT_FROM_EMAIL=Portfolio <onboarding@resend.dev>
CONTACT_TO_EMAIL=you@example.com

# --- Resume PDF microservice (services/resume-pdf) ---
# Local dev default matches that service's PORT. In production, point this at
# wherever you deploy resume-pdf (Render/Railway/Fly/etc).
NEXT_PUBLIC_RESUME_PDF_URL=http://localhost:4001
