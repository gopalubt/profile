# Where generated PDFs are written. Absolute path recommended.
UPLOAD_DIR=./uploaded_files

# Public URL prefix that maps to UPLOAD_DIR.
PUBLIC_UPLOAD_PATH=/uploaded_files

# Google Static Maps key. SECRET - never commit a real value.
# The key that was hardcoded in the legacy file is compromised and must be rotated.
# Leave blank to omit the map from the PDF.
GOOGLE_MAPS_API_KEY=

# Hard ceiling on page load and PDF generation, in ms. Never set this to 0.
PDF_TIMEOUT_MS=60000

# Concurrent renders. Each open page costs real memory.
PDF_MAX_CONCURRENT=3

# Required when running as root in a container. Set to false if running unprivileged.
PUPPETEER_NO_SANDBOX=true

# Shown when a media asset is missing.
PLACEHOLDER_IMAGE_URL=https://upload.wikimedia.org/wikipedia/commons/6/65/No-Image-Placeholder.svg
