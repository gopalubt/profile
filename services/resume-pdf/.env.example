# Port this service listens on.
PORT=4001

# Comma-separated list of origins allowed to call this API (your portfolio site).
# In production, set this to your real domain(s) - no wildcard.
CORS_ORIGIN=http://localhost:3000

# Hard ceiling on page load and PDF generation, in ms. Never 0 (infinite).
PDF_TIMEOUT_MS=60000

# Concurrent renders allowed. Each open Chromium page costs real memory -
# keep this low on small hosts (Render/Railway free/hobby tiers).
PDF_MAX_CONCURRENT=2

# Required in containers running as root; drop it if you run unprivileged.
PUPPETEER_NO_SANDBOX=true
